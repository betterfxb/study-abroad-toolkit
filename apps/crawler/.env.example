# ---- 运行环境 ----
APP_ENV=dev
LOG_LEVEL=INFO

# ---- 存储 ----
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/study_abroad
REDIS_URL=redis://redis:6379/0

# ---- LLM（留空则自动降级到规则抽取）----
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL_FAST=gpt-4o-mini
LLM_MODEL_STRONG=gpt-4o
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=3

# ---- 采集 ----
CRAWLER_UA=Mozilla/5.0 (compatible; StudyAbroadBot/0.1; +https://example.com/bot)
CRAWLER_PROXY=
CRAWLER_TIMEOUT_S=20
CRAWLER_RATE_LIMIT=10
CRAWLER_CONCURRENCY=4

# ---- 合规开关（硬约束）----
CRAWLER_RESPECT_ROBOTS=true
CRAWLER_STORE_FULLTEXT=false
CRAWLER_DEGRADE_LEVEL=0

# ---- 去重 ----
# 中文按字符 n-gram 切片，实测同文改写距离 5~8、无关文章 30+，故取 8
DEDUP_SIMHASH_BITS=64
DEDUP_SIMHASH_THRESHOLD=8
