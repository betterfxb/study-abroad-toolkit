# api-gateway 环境变量（复制为 .env 后按需修改）

# 服务端口（架构规划：crawler 8100 / intelligence 8090 / gateway 8080）
PORT=8080
HOST=0.0.0.0

# JWT 密钥（生产必须替换为随机长字符串）
JWT_SECRET=dev-secret-change-me

# 数据库：留空使用内存库（重启即清空）；生产建议指向文件或改用 PostgreSQL
# DB_PATH=./data/gateway.db
DB_PATH=

# SQLite 日志模式（wal / delete / truncate / persist / memory / off）
# 默认：Windows 用 delete，其他平台用 wal。
# 原因：Windows 下 WAL + 多进程同时打开会让一方连接永久只读（重试无效），delete 无此问题。
# 确需 Windows 上启用 WAL 时可显式设置，服务内置只读自愈会兜底。
# SQLITE_JOURNAL_MODE=delete

# 上游服务地址
CRAWLER_BASE=http://localhost:8100
INTELLIGENCE_BASE=http://localhost:8090
PROXY_TIMEOUT_MS=15000

# 订阅定时调度
SCHEDULER_ENABLED=1
SCHEDULER_INTERVAL_MS=60000
SCHEDULER_TZ_OFFSET=480
# 多实例部署建议显式指定实例标识，便于定位锁归属
# SCHEDULER_INSTANCE_ID=gateway-1
# 抢占锁 TTL（毫秒），超时视为持有者已崩溃、可被其他实例接管
SCHEDULER_LOCK_TTL_MS=300000
