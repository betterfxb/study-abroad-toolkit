        { "selector": "#cumgpa", "label": "Cumulative Grade Point Average", "name": "cumGpa", "type": "number", "expect_key": "education[0].gpa" },
        { "selector": "#awa", "label": "AWA", "name": "awa", "type": "number", "expect_key": "tests[0].aw" },
        { "selector": "#toeflTotal", "label": "Toefl Total", "name": "toeflTotal", "type": "number", "expect_key": "tests[0].total" },
        { "selector": "#addr1", "label": "Permanent Address Line 1", "name": "permAddr1", "type": "text", "expect_key": "address.street" },
        { "selector": "#zipPostal", "label": "Zip/Postal Code", "name": "zipPostal", "type": "text", "expect_key": "address.postal" }
      ]
    },
    {
      "id": "h03_nonenglish_and_nolabel",
      "system_code": "slate",
      "name": "非英文标签 / 无 label 仅 placeholder",
      "fields": [
        { "selector": "#nom", "label": "Nom de famille", "name": "nom", "type": "text", "expect_key": "basic_info.last_name" },
        { "selector": "#nachname", "label": "Nachname", "name": "nachname", "type": "text", "expect_key": "basic_info.last_name" },
        { "selector": "#vorname", "label": "Vorname", "name": "vorname", "type": "text", "expect_key": "basic_info.first_name" },
        { "selector": "#field_27", "name": "field_27", "placeholder": "Enter the name of your current employer", "type": "text", "expect_key": "experiences[0].org" },
        { "selector": "#field_31", "name": "field_31", "placeholder": "Job title", "type": "text", "expect_key": "experiences[0].role" },
        { "selector": "#field_42", "name": "field_42", "placeholder": "If applicable, enter your middle name", "type": "text", "expect_key": "basic_info.middle_name" },
        { "selector": "#cc", "label": "Country Code", "name": "countryCode", "type": "text", "expect_key": null },
        { "selector": "#years", "label": "How many years of work experience do you have?", "name": "yearsExp", "type": "number", "expect_key": null }
      ]
    }
  ]
