        { "selector": "#q_country", "label": "Country of intended study", "name": "q_country", "type": "select", "options": ["China", "United States"], "expect_key": null },
        { "selector": "#q_name", "label": "Name three academic honors you have received", "name": "q_name", "type": "textarea", "expect_key": null }
      ]
    },
    {
      "id": "h02_industry_jargon",
      "system_code": "liaison",
      "name": "行业黑话 / 部门口径",
