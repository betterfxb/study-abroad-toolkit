        { "selector": "#testDate1", "label": "Test Date", "name": "testDate1", "type": "date", "expect_key": "tests[0].test_date" },
        { "selector": "#addr1", "label": "Street Address", "name": "addressLine1", "type": "text", "expect_key": "address.street" },
        { "selector": "#addr2", "label": "Address Line 2", "name": "addressLine2", "type": "text", "expect_key": "address.street2" },
        { "selector": "#city", "label": "City", "name": "city", "type": "text", "expect_key": "address.city" },
        { "selector": "#state", "label": "State/Province", "name": "stateProvince", "type": "select", "options": ["Beijing", "Shanghai", "Guangdong", "California", "New York"], "expect_key": "address.state" },
        { "selector": "#postal", "label": "Postal Code", "name": "postalCode", "type": "text", "expect_key": "address.postal" },
        { "selector": "#country", "label": "Country", "name": "country", "type": "select", "options": ["China", "United States", "India", "Japan"], "expect_key": "address.country" },
        { "selector": "#ecName", "label": "Emergency Contact Name", "name": "emergencyContactName", "type": "text", "expect_key": "emergency_contact.name" },
        { "selector": "#ecPhone", "label": "Emergency Contact Phone", "name": "emergencyContactPhone", "type": "tel", "expect_key": "emergency_contact.phone" }
      ]
