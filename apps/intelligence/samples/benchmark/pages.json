        { "selector": "#phone", "label": "Mobile Phone Number *", "name": "phoneNumber", "type": "tel", "required": true, "expect_key": "basic_info.phone" },
        { "selector": "#dob", "label": "Date of Birth", "name": "dateOfBirth", "type": "date", "placeholder": "MM/DD/YYYY", "expect_key": "basic_info.birth_date" },
