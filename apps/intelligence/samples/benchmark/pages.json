        { "selector": "#end1", "label": "Attendance To", "name": "attendanceTo1", "type": "date", "placeholder": "MM/YYYY", "expect_key": "education[0].end_date" },
        { "selector": "#gpa1", "label": "GPA", "name": "gpa1", "type": "number", "expect_key": "education[0].gpa" },
        { "selector": "#gpaScale1", "label": "GPA Scale", "name": "gpaScale1", "type": "number", "expect_key": "education[0].gpa_scale" },
        { "selector": "#inst2", "label": "Institution Name", "name": "institution2", "type": "text", "expect_key": "education[1].institution" },
        { "selector": "#degree2", "label": "Degree Earned", "name": "degree2", "type": "select", "options": ["Bachelor's Degree", "Master's Degree", "Doctoral Degree"], "expect_key": "education[1].degree" },
        { "selector": "#major2", "label": "Field of Study", "name": "fieldOfStudy2", "type": "text", "expect_key": "education[1].major" }
      ]
    },
    {
      "id": "p03_slate_tests_address",
