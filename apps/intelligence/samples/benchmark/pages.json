        { "selector": "#birthCountry", "label": "Country of Birth", "name": "countryOfBirth", "type": "select", "options": ["China", "United States", "India"], "expect_key": "basic_info.birth_country" },
        { "selector": "#birthCity", "label": "City of Birth", "name": "cityOfBirth", "type": "text", "expect_key": "basic_info.birth_city" },
        { "selector": "#marital", "label": "Marital Status", "name": "maritalStatus", "type": "select", "options": ["Single", "Married", "Divorced"], "expect_key": "basic_info.marital_status" },
        { "selector": "#hearAbout", "label": "How did you hear about us?", "name": "hearAboutUs", "type": "text", "expect_key": null },
        { "selector": "#customQ1", "label": "Do you require a student visa?", "name": "customQuestion1", "type": "select", "options": ["Yes", "No"], "expect_key": null }
